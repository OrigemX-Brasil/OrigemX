{
  "name": "origem-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "supabase migration new",
    "db:list": "supabase migration list --linked",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > src/lib/types/database.ts",
    "db:founder-reset": "supabase db query --linked --file supabase/tests/reset-founder-seq.sql",
    "seed:pedigree": "supabase db query --linked --file supabase/tests/seed-pedigree-demo.sql",
    "seed:load": "supabase db query --linked --file supabase/tests/seed-load.sql",
    "seed:load-clean": "supabase db query --linked --file supabase/tests/seed-load-clean.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:rls": "node --env-file-if-exists=.env.local scripts/test-rls.mts",
    "media:reconcile": "node --env-file-if-exists=.env.local scripts/reconcile-media.mts",
    "metrics": "node --env-file-if-exists=.env.local scripts/metrics.mts",
    "evidence:baseline": "npm run db:founder-reset && npm run test:rls && node --env-file-if-exists=.env.local scripts/policy-baseline.mts --out reports/baseline-pre-pedigree.md --label \"antes da reescrita de dogs_select\"",
    "evidence:compare": "npm run db:founder-reset && npm run test:rls && node --env-file-if-exists=.env.local scripts/policy-baseline.mts --out reports/baseline-post-pedigree.md --compare reports/baseline-pre-pedigree.md --label \"depois da reescrita de dogs_select\""
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
