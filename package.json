{
  "name": "origem-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "supabase migration new",
    "db:list": "supabase migration list --linked",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > src/lib/types/database.ts",
    "db:founder-reset": "supabase db query --linked --file supabase/tests/reset-founder-seq.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file-if-exists=.env.local scripts/test-rls.mts",
    "media:reconcile": "node --env-file-if-exists=.env.local scripts/reconcile-media.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
